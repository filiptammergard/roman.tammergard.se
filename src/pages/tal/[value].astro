---
import Layout from "../../layouts/Layout.astro"
import { toRoman } from "@tammergard/roman"
import { MAX, MIN, detect, safeFromRoman, safeToRoman } from "../../lib/roman"

const { value: rawValue } = Astro.params
if (!rawValue) return Astro.redirect("/", 302)

const decoded = decodeURIComponent(rawValue)
const detected = detect(decoded)

let arabic: number | null = null
let roman: string | null = null

if (detected.kind === "arabic") {
	arabic = detected.value
	roman = safeToRoman(detected.value)
} else if (detected.kind === "roman") {
	arabic = safeFromRoman(detected.value)
	roman = arabic === null ? null : toRoman(arabic)
}

if (arabic === null || roman === null) {
	return new Response(null, { status: 404 })
}

const safe: number = arabic
const safeRoman: string = roman

const neighbors = [-2, -1, 1, 2]
	.map((offset) => safe + offset)
	.filter((n) => n >= MIN && n <= MAX)
	.map((n) => ({ arabic: n, roman: toRoman(n) }))

const halves: Array<{ label: string; arabic: number; roman: string }> = []
if (safe * 2 <= MAX) {
	halves.push({
		label: "Dubbelt",
		arabic: safe * 2,
		roman: toRoman(safe * 2),
	})
}
if (safe > 1 && safe % 2 === 0) {
	halves.push({
		label: "Hälften",
		arabic: safe / 2,
		roman: toRoman(safe / 2),
	})
}
if (safe * 10 <= MAX) {
	halves.push({
		label: "Tio gånger",
		arabic: safe * 10,
		roman: toRoman(safe * 10),
	})
}

const breakdown: Array<{ value: number; symbol: string }> = []
{
	const PIECES: Array<[number, string]> = [
		[1000, "M"],
		[900, "CM"],
		[500, "D"],
		[400, "CD"],
		[100, "C"],
		[90, "XC"],
		[50, "L"],
		[40, "XL"],
		[10, "X"],
		[9, "IX"],
		[5, "V"],
		[4, "IV"],
		[1, "I"],
	]
	let remaining = safe
	for (const [v, s] of PIECES) {
		while (remaining >= v) {
			breakdown.push({ value: v, symbol: s })
			remaining -= v
		}
	}
}

const title = `${safeRoman} = ${safe} · Romerska siffror`
const description = `${safe} skrivs ${safeRoman} med romerska siffror.`

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=604800, stale-while-revalidate=86400",
)

const prev = safe > MIN ? safe - 1 : null
const next = safe < MAX ? safe + 1 : null
---

<Layout title={title} description={description}>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<p class="text-center">
			<a
				href="/"
				class="inscription text-shadow hover:text-inscription text-xs underline-offset-4 hover:underline"
			>
				← Numeri Romanorum
			</a>
		</p>

		<header class="mt-10 mb-16 text-center">
			<p class="text-shadow inscription text-xs">Numerus</p>
			<div class="my-5 flex items-center justify-center gap-4">
				<span class="bg-inscription/70 h-px w-16" aria-hidden="true"
				></span>
				<span class="text-laurel text-2xl" aria-hidden="true">❦</span>
				<span class="bg-inscription/70 h-px w-16" aria-hidden="true"
				></span>
			</div>
			<p
				class="inscription carved text-6xl font-extrabold tracking-widest md:text-9xl"
			>
				{safeRoman}
			</p>
			<p
				class="text-shadow mt-6 text-3xl tracking-wide md:text-4xl"
			>
				= {safe.toLocaleString("sv-SE")}
			</p>
		</header>

		<section
			class="border-rule mb-12 border-y-2 border-double py-8"
		>
			<p
				class="text-shadow inscription mb-4 text-center text-xs"
			>
				Uppdelning
			</p>
			<ol
				class="flex flex-wrap items-baseline justify-center gap-x-3 gap-y-2"
			>
				{
					breakdown.map((piece, i) => (
						<>
							{i > 0 && (
								<span class="text-shadow text-2xl" aria-hidden="true">
									+
								</span>
							)}
							<li class="text-center">
								<p class="inscription carved text-3xl font-bold tracking-wider">
									{piece.symbol}
								</p>
								<p class="text-shadow text-xs">{piece.value}</p>
							</li>
						</>
					))
				}
			</ol>
		</section>

		{
			halves.length > 0 && (
				<section class="mb-12">
					<p class="text-shadow inscription mb-4 text-center text-xs">
						Släkttal
					</p>
					<ul class="grid grid-cols-1 gap-3 sm:grid-cols-3">
						{halves.map((h) => (
							<li class="border-rule rounded border p-4 text-center">
								<p class="text-shadow inscription text-[0.65rem]">
									{h.label}
								</p>
								<a
									href={`/tal/${h.arabic}`}
									class="hover:text-imperial inscription carved mt-2 block text-2xl font-bold tracking-wider"
								>
									{h.roman}
								</a>
								<p class="text-shadow mt-1 text-sm">{h.arabic}</p>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section class="mb-12">
			<p class="text-shadow inscription mb-4 text-center text-xs">
				Grannar
			</p>
			<ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
				{
					neighbors.map((n) => (
						<li class="border-rule rounded border p-3 text-center">
							<a
								href={`/tal/${n.arabic}`}
								class="hover:text-imperial inscription block text-xl font-semibold tracking-wider"
							>
								{n.roman}
							</a>
							<p class="text-shadow mt-1 text-xs">{n.arabic}</p>
						</li>
					))
				}
			</ul>
		</section>

		<nav
			class="border-rule mt-16 flex items-center justify-between border-t pt-6"
		>
			{
				prev !== null ? (
					<a
						href={`/tal/${prev}`}
						class="inscription text-shadow hover:text-inscription text-xs"
					>
						← {toRoman(prev)}
					</a>
				) : (
					<span />
				)
			}
			{
				next !== null ? (
					<a
						href={`/tal/${next}`}
						class="inscription text-shadow hover:text-inscription text-xs"
					>
						{toRoman(next)} →
					</a>
				) : (
					<span />
				)
			}
		</nav>
	</main>
</Layout>
