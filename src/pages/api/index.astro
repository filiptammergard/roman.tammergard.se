---
import Layout from "../../layouts/Layout.astro"
import LaurelDivider from "../../components/LaurelDivider.astro"

const title = "API · Roman Numerals"
const description =
	"A simple JSON API to convert between arabic and roman numerals (1–3999)."

const base = `${Astro.site?.origin ?? Astro.url.origin}/api/v1`

const endpoints: Array<{
	method: string
	path: string
	description: string
	example: string
}> = [
	{
		method: "GET",
		path: "/api/v1/to/{n}",
		description: "Convert an arabic number (1–3999) to a roman numeral.",
		example: `${base}/to/2026`,
	},
	{
		method: "GET",
		path: "/api/v1/from/{roman}",
		description: "Convert a roman numeral to an arabic number.",
		example: `${base}/from/MMXXVI`,
	},
	{
		method: "GET",
		path: "/api/v1/validate/{roman}",
		description: "Check whether a string is a well-formed roman numeral (1–3999).",
		example: `${base}/validate/MMXXVI`,
	},
	{
		method: "GET",
		path: "/api/v1/convert/{value}",
		description:
			"Convert in either direction automatically. Accepts either an arabic number or a roman numeral.",
		example: `${base}/convert/MMXXVI`,
	},
	{
		method: "GET",
		path: "/api/v1/today",
		description:
			"Today's date (Europe/Stockholm) as roman numerals, with the Latin month name.",
		example: `${base}/today`,
	},
	{
		method: "GET",
		path: "/api/v1/all",
		description:
			"All numerals from 1 to 3999 as arabic/roman pairs. The response is around 100 KB.",
		example: `${base}/all`,
	},
]

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=3600, stale-while-revalidate=86400",
)
---

<Layout title={title} description={description}>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<p class="text-center">
			<a
				href="/"
				class="inscription text-shadow hover:text-imperial text-xs underline-offset-4 hover:underline"
			>
				← Roman · Numerals
			</a>
		</p>

		<header class="mt-10 mb-16 text-center">
			<p class="text-shadow inscription text-xs">
				· Developer · Documentation ·
			</p>
			<LaurelDivider class="my-8" />
			<h1 class="inscription carved-deep text-5xl md:text-6xl">
				API
			</h1>
			<p class="text-shadow inscription mt-4 text-xs">
				Version · I · JSON · CORS
			</p>
		</header>

		<section class="mb-14">
			<h2 class="inscription carved-deep mb-4 text-2xl">
				· Overview ·
			</h2>
			<p class="font-serif leading-relaxed">
				A read-only API for roman numerals. All endpoints return JSON
				and allow CORS from any origin. Static responses (everything
				except <code class="font-mono">/today</code>) are CDN-cached
				for a week; <code class="font-mono">/today</code> is cached
				until the next midnight in Europe/Stockholm. Browsers always
				revalidate (<code class="font-mono">max-age=0</code>).
			</p>
			<p class="mt-3 font-serif leading-relaxed">
				The valid range is <code class="font-mono">1</code>–<code
					class="font-mono">3999</code
				>, which is what classical roman numerals can express.
			</p>
		</section>

		<LaurelDivider label="Endpoints" class="mb-10" />

		<section class="mb-14">
			<ul class="space-y-8">
				{
					endpoints.map((endpoint) => (
						<li class="slab rounded-sm p-5">
							<p class="font-mono text-sm">
								<span class="bg-inscription text-marble inscription mr-2 rounded-sm px-2 py-0.5 text-xs">
									{endpoint.method}
								</span>
								<span class="font-bold">{endpoint.path}</span>
							</p>
							<p class="mt-2 font-serif leading-relaxed">
								{endpoint.description}
							</p>
							<p class="mt-2">
								<a
									href={endpoint.example.replace(Astro.site?.origin ?? Astro.url.origin, "")}
									class="text-shadow hover:text-imperial break-all font-mono text-sm underline-offset-4 hover:underline"
								>
									{endpoint.example}
								</a>
							</p>
						</li>
					))
				}
			</ul>
		</section>

		<LaurelDivider label="Response" class="mb-10" />

		<section class="mb-14">
			<p class="font-serif leading-relaxed">
				<code class="font-mono">/to/{"{n}"}</code> and <code
					class="font-mono">/from/{"{roman}"}</code
				> return a pair:
			</p>
			<pre
				class="bg-inscription/5 border-rule mt-3 overflow-x-auto rounded-sm border p-4 font-mono text-sm">{`{
  "arabic": 2026,
  "roman": "MMXXVI"
}`}</pre>
			<p class="mt-6 font-serif leading-relaxed">
				<code class="font-mono">/convert/{"{value}"}</code> additionally
				includes a <code class="font-mono">kind</code> field that shows
				which direction it converted:
			</p>
			<pre
				class="bg-inscription/5 border-rule mt-3 overflow-x-auto rounded-sm border p-4 font-mono text-sm">{`{
  "kind": "roman",
  "input": "MMXXVI",
  "roman": "MMXXVI",
  "arabic": 2026
}`}</pre>
		</section>

		<LaurelDivider label="Errors" class="mb-10" />

		<section class="mb-14">
			<p class="font-serif leading-relaxed">
				Errors are returned as JSON. Status codes:
			</p>
			<ul
				class="mt-3 list-disc space-y-1 pl-6 font-serif leading-relaxed"
			>
				<li>
					<code class="font-mono">400</code> – missing or malformed
					parameter (e.g. empty string, invalid characters).
				</li>
				<li>
					<code class="font-mono">422</code> – well-formed input but
					invalid value (e.g. <code class="font-mono">/to/5000</code> or
					<code class="font-mono">/from/IIII</code>).
				</li>
			</ul>
			<pre
				class="bg-inscription/5 border-rule mt-3 overflow-x-auto rounded-sm border p-4 font-mono text-sm">{`{
  "error": {
    "status": 422,
    "message": "Invalid number \\"5000\\". Must be between 1 and 3999."
  }
}`}</pre>
		</section>

		<LaurelDivider label="Source" class="mb-10" />

		<section class="mb-14">
			<p class="font-serif leading-relaxed">
				This API is built on the <a
					href="https://www.npmjs.com/package/@tammergard/roman"
					class="hover:text-imperial font-bold underline-offset-4 hover:underline"
					>@tammergard/roman</a
				> package on npm.
			</p>
		</section>

		<p class="mt-16 text-center">
			<a
				href="/"
				class="inscription text-shadow hover:text-imperial text-xs underline underline-offset-4"
			>
				Back
			</a>
		</p>
	</main>
</Layout>
