---
import Layout from "../../layouts/Layout.astro"

const title = "API · Romerska siffror"
const description =
	"Ett enkelt JSON-API för att konvertera till och från romerska siffror (1–3999)."

const base = `${Astro.url.origin}/api/v1`

const endpoints: Array<{
	method: string
	path: string
	description: string
	example: string
}> = [
	{
		method: "GET",
		path: "/api/v1/to/{n}",
		description: "Konvertera ett arabiskt tal (1–3999) till romerska siffror.",
		example: `${base}/to/2026`,
	},
	{
		method: "GET",
		path: "/api/v1/from/{roman}",
		description: "Konvertera ett romerskt tal till arabiska siffror.",
		example: `${base}/from/MMXXVI`,
	},
	{
		method: "GET",
		path: "/api/v1/validate/{roman}",
		description:
			"Kontrollera om en sträng är ett välformat romerskt tal (1–3999).",
		example: `${base}/validate/MMXXVI`,
	},
	{
		method: "GET",
		path: "/api/v1/convert/{value}",
		description:
			"Konvertera åt rätt håll automatiskt. Tar emot antingen ett arabiskt tal eller ett romerskt.",
		example: `${base}/convert/MMXXVI`,
	},
	{
		method: "GET",
		path: "/api/v1/today",
		description:
			"Dagens datum (Europe/Stockholm) som romerska siffror, med latinskt månadsnamn.",
		example: `${base}/today`,
	},
	{
		method: "GET",
		path: "/api/v1/all",
		description:
			"Alla tal från 1 till 3999 som arabiska och romerska par. Svaret är drygt 100 KB.",
		example: `${base}/all`,
	},
]

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=3600, stale-while-revalidate=86400",
)
---

<Layout title={title} description={description}>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<p class="text-center">
			<a
				href="/"
				class="inscription text-shadow hover:text-inscription text-xs underline-offset-4 hover:underline"
			>
				← Numeri Romanorum
			</a>
		</p>

		<header class="mt-10 mb-16 text-center">
			<p class="text-shadow inscription text-xs">
				Documentum Programmatoribus
			</p>
			<div class="my-5 flex items-center justify-center gap-4">
				<span class="bg-inscription/70 h-px w-16" aria-hidden="true"
				></span>
				<span class="text-laurel text-2xl" aria-hidden="true">❦</span>
				<span class="bg-inscription/70 h-px w-16" aria-hidden="true"
				></span>
			</div>
			<h1 class="inscription carved text-5xl">API</h1>
			<p class="text-shadow inscription mt-4 text-xs">
				Versio I · JSON · CORS
			</p>
		</header>

		<section class="mb-12">
			<h2 class="inscription carved mb-3 text-2xl">Översikt</h2>
			<p class="leading-relaxed">
				Ett läs-API för romerska siffror. Alla endpoints returnerar
				JSON och stöder CORS från alla ursprung. Statiska svar (alla
				utom <code class="font-mono">/today</code>) CDN-cachas i en vecka;
				<code class="font-mono">/today</code> cachas fram till nästa midnatt
				i Europe/Stockholm. Webbläsare revaliderar alltid (<code
					class="font-mono">max-age=0</code
				>).
			</p>
			<p class="mt-3 leading-relaxed">
				Giltigt intervall är <code class="font-mono">1</code>–<code
					class="font-mono">3999</code
				>, vilket är vad klassiska romerska siffror kan uttrycka.
			</p>
		</section>

		<section class="mb-12">
			<h2 class="inscription carved mb-6 text-2xl">Endpoints</h2>
			<ul class="space-y-8">
				{
					endpoints.map((endpoint) => (
						<li class="border-rule border-b border-dotted pb-6">
							<p class="font-mono text-sm">
								<span class="bg-inscription text-marble inscription mr-2 rounded px-2 py-0.5 text-xs">
									{endpoint.method}
								</span>
								<span class="font-bold">{endpoint.path}</span>
							</p>
							<p class="mt-2 leading-relaxed">{endpoint.description}</p>
							<p class="mt-2">
								<a
									href={endpoint.example.replace(Astro.url.origin, "")}
									class="text-shadow hover:text-inscription break-all font-mono text-sm underline-offset-4 hover:underline"
								>
									{endpoint.example}
								</a>
							</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mb-12">
			<h2 class="inscription carved mb-3 text-2xl">Svarsformat</h2>
			<p class="leading-relaxed">
				<code class="font-mono">/to/{"{n}"}</code> och <code
					class="font-mono">/from/{"{roman}"}</code
				> returnerar ett par:
			</p>
			<pre
				class="bg-inscription/5 border-rule mt-3 overflow-x-auto rounded border p-4 font-mono text-sm">{`{
  "arabic": 2026,
  "roman": "MMXXVI"
}`}</pre>
			<p class="mt-6 leading-relaxed">
				<code class="font-mono">/convert/{"{value}"}</code> inkluderar dessutom
				en <code class="font-mono">kind</code> som visar åt vilket håll
				den konverterade:
			</p>
			<pre
				class="bg-inscription/5 border-rule mt-3 overflow-x-auto rounded border p-4 font-mono text-sm">{`{
  "kind": "roman",
  "input": "MMXXVI",
  "roman": "MMXXVI",
  "arabic": 2026
}`}</pre>
		</section>

		<section class="mb-12">
			<h2 class="inscription carved mb-3 text-2xl">Fel</h2>
			<p class="leading-relaxed">
				Fel returneras som JSON. Statuskoder:
			</p>
			<ul class="mt-3 list-disc space-y-1 pl-6 leading-relaxed">
				<li>
					<code class="font-mono">400</code> – saknad eller felformaterad
					parameter (t.ex. tom sträng, ogiltiga tecken).
				</li>
				<li>
					<code class="font-mono">422</code> – giltig form men ogiltigt
					värde (t.ex. <code class="font-mono">/to/5000</code> eller <code
						class="font-mono">/from/IIII</code
					>).
				</li>
			</ul>
			<pre
				class="bg-inscription/5 border-rule mt-3 overflow-x-auto rounded border p-4 font-mono text-sm">{`{
  "error": {
    "status": 422,
    "message": "Invalid number \\"5000\\". Must be between 1 and 3999."
  }
}`}</pre>
		</section>

		<section class="mb-12">
			<h2 class="inscription carved mb-3 text-2xl">Källkod</h2>
			<p class="leading-relaxed">
				API:et bygger på <a
					href="https://www.npmjs.com/package/@tammergard/roman"
					class="hover:text-imperial font-bold underline-offset-4 hover:underline"
					>@tammergard/roman</a
				>-paketet på npm.
			</p>
		</section>

		<p class="mt-16 text-center">
			<a
				href="/"
				class="inscription text-shadow hover:text-inscription text-xs underline underline-offset-4"
			>
				Tillbaka
			</a>
		</p>
	</main>
</Layout>
