---
import Layout from "../layouts/Layout.astro"
import LaurelWreath from "../components/LaurelWreath.astro"
import LaurelDivider from "../components/LaurelDivider.astro"
import { toRoman } from "@tammergard/roman"
import {
	detect,
	englishDate,
	latinDate,
	safeFromRoman,
	safeToRoman,
} from "../lib/roman"
import { getStockholmToday } from "../lib/today"

const params = Astro.url.searchParams
const query = (params.get("q") ?? "").trim()

const today = getStockholmToday()
const todayLatin = latinDate(today.month, today.day, today.year)
const todayEnglish = englishDate(today.month, today.day, today.year)
const yearRoman = toRoman(today.year)

type QueryResult =
	| { ok: true; arabic: number; roman: string; original: string }
	| { ok: false; reason: string; original: string }

let queryResult: QueryResult | null = null
if (query) {
	const detected = detect(query)
	if (detected.kind === "invalid") {
		queryResult = { ok: false, reason: detected.reason, original: query }
	} else if (detected.kind === "arabic") {
		const roman = safeToRoman(detected.value)
		if (roman === null) {
			queryResult = {
				ok: false,
				reason: `${detected.value} cannot be written as a roman numeral (valid range: 1–3999).`,
				original: query,
			}
		} else {
			queryResult = {
				ok: true,
				arabic: detected.value,
				roman,
				original: query,
			}
		}
	} else {
		const arabic = safeFromRoman(detected.value)
		if (arabic === null) {
			queryResult = {
				ok: false,
				reason: `"${detected.value}" is not a well-formed roman numeral.`,
				original: query,
			}
		} else {
			queryResult = {
				ok: true,
				arabic,
				roman: detected.value,
				original: query,
			}
		}
	}
}

const milestones = [
	{ label: "Ones", from: 1, to: 10 },
	{ label: "Tens", from: 10, to: 100, step: 10 },
	{ label: "Hundreds", from: 100, to: 1000, step: 100 },
	{ label: "Thousands", from: 1000, to: 3000, step: 1000 },
	{ label: "The Largest", from: 3999, to: 3999 },
] as const

const sections = milestones.map((section) => {
	const step = "step" in section ? section.step : 1
	const items: Array<{ arabic: number; roman: string }> = []
	for (let n = section.from; n <= section.to; n += step) {
		items.push({ arabic: n, roman: toRoman(n) })
	}
	return { label: section.label, items }
})

const title =
	queryResult && queryResult.ok
		? `${queryResult.arabic} = ${queryResult.roman} · Roman Numerals`
		: "Roman Numerals"

const description = `Convert between arabic and roman numerals. Today is ${todayEnglish} (${todayLatin}).`

function resultClasses(len: number): string {
	if (len <= 6) return "text-5xl md:text-7xl tracking-[0.18em]"
	if (len <= 9) return "text-4xl md:text-6xl tracking-[0.12em]"
	if (len <= 12) return "text-3xl md:text-5xl tracking-[0.08em]"
	return "text-2xl md:text-4xl tracking-[0.04em]"
}

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=3600, stale-while-revalidate=86400",
)
---

<Layout title={title} description={description}>
	<main class="mx-auto max-w-4xl px-6 py-16">
		<header class="mb-20 text-center">
			<div class="flex justify-center">
				<LaurelWreath center="SPQR" size={220} />
			</div>
			<h1
				class="inscription carved-deep mt-4 text-5xl font-extrabold md:text-7xl"
			>
				Roman · Numerals
			</h1>
			<p
				class="text-shadow inscription mt-3 text-xs tracking-[0.35em] md:text-sm"
			>
				I — MMMCMXCIX
			</p>
		</header>

		<!-- Today inscription: tabula ansata -->
		<section class="mb-20 flex justify-center">
			<div class="tabula relative mx-8 px-10 py-7 text-center">
				<p class="text-shadow inscription text-[0.6rem] md:text-xs">
					Today
				</p>
				<p
					class="inscription carved-deep mt-3 text-2xl md:text-4xl"
				>
					{todayLatin}
				</p>
				<div class="bg-rule/60 mx-auto my-3 h-px w-24"></div>
				<p class="text-shadow inscription text-[0.6rem] md:text-xs">
					Anno · {yearRoman} · {todayEnglish}
				</p>
			</div>
		</section>

		<!-- Converter -->
		<section class="mb-24">
			<LaurelDivider label="Convert" class="mb-10" />
			<form method="get" action="/" class="mx-auto max-w-xl">
				<label
					for="q"
					class="text-shadow inscription block text-center text-xs"
				>
					Roman or arabic
				</label>
				<div
					class="border-inscription bg-marble-deep/40 mt-4 flex gap-3 border-b-[3px] px-3 pb-2"
				>
					<input
						id="q"
						name="q"
						type="search"
						value={query}
						placeholder="123 · CXXIII"
						autocomplete="off"
						spellcheck="false"
						class="placeholder:text-shadow/60 inscription flex-1 bg-transparent text-2xl tracking-[0.2em] outline-none"
					/>
					<button
						type="submit"
						class="inscription text-shadow hover:text-imperial text-sm transition"
					>
						Convert
					</button>
				</div>
			</form>

			{
				queryResult && (
					<div class="mx-auto mt-12 max-w-xl text-center">
						{queryResult.ok ? (
							<div class="space-y-3">
								<p class="text-shadow inscription text-[0.65rem]">
									· Result ·
								</p>
								<div class="flex flex-col items-center justify-center gap-4 md:flex-row md:gap-10">
									<a
										href={`/n/${queryResult.arabic}`}
										class:list={[
											"hover:text-imperial inscription carved-deep font-extrabold",
											resultClasses(queryResult.roman.length),
										]}
									>
										{queryResult.roman}
									</a>
									<span
										class="text-bronze text-4xl font-light"
										aria-hidden="true"
									>
										|
									</span>
									<a
										href={`/n/${queryResult.arabic}`}
										class:list={[
											"hover:text-imperial inscription carved-deep font-extrabold",
											resultClasses(String(queryResult.arabic).length),
										]}
									>
										{queryResult.arabic}
									</a>
								</div>
							</div>
						) : (
							<p class="text-imperial inscription text-base italic">
								{queryResult.reason}
							</p>
						)}
					</div>
				)
			}
		</section>

		<LaurelDivider label="All numerals" class="mb-12" />

		<nav
			aria-label="Jump to section"
			class="border-rule mb-14 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-y-2 border-double py-4"
		>
			{
				sections.map((section, i) => (
					<a
						href={`#sec-${i}`}
						class="text-shadow hover:text-imperial inscription text-xs transition"
					>
						{section.label}
					</a>
				))
			}
		</nav>

		{
			sections.map((section, i) => (
				<section id={`sec-${i}`} class="mb-16 scroll-mt-6">
					<h2 class="inscription carved-deep mb-6 text-center text-2xl md:text-3xl">
						· {section.label} ·
					</h2>
					<ul class="grid grid-cols-1 gap-x-12 gap-y-1 sm:grid-cols-2 md:grid-cols-3">
						{section.items.map((item) => (
							<li class="border-rule/60 flex items-baseline justify-between border-b border-dotted py-2">
								<a
									href={`/n/${item.arabic}`}
									class="hover:text-imperial inscription text-lg font-semibold tracking-[0.15em]"
								>
									{item.roman}
								</a>
								<a
									href={`/n/${item.arabic}`}
									class="text-shadow hover:text-inscription font-serif text-sm"
								>
									{item.arabic}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}

		<LaurelDivider class="my-20" />

		<footer class="text-center">
			<p class="text-shadow inscription text-xs">
				<a
					href="/api"
					class="hover:text-imperial underline-offset-4 hover:underline"
				>
					API
				</a>
				<span class="text-bronze mx-3" aria-hidden="true">·</span>
				<a
					href="https://www.npmjs.com/package/@tammergard/roman"
					class="hover:text-imperial underline-offset-4 hover:underline"
				>
					@tammergard/roman
				</a>
			</p>
		</footer>
	</main>
</Layout>
