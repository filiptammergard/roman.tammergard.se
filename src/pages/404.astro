---
import Layout from "../layouts/Layout.astro"
---

<Layout
	title="Sidan saknas · Romerska siffror"
	description="Sidan kunde inte hittas."
>
	<main class="mx-auto max-w-2xl px-6 py-24 text-center">
		<p class="text-shadow inscription text-xs">CDIV</p>
		<div class="my-6 flex items-center justify-center gap-4">
			<span class="bg-inscription/70 h-px w-16" aria-hidden="true"
			></span>
			<span class="text-laurel text-2xl" aria-hidden="true">❦</span>
			<span class="bg-inscription/70 h-px w-16" aria-hidden="true"
			></span>
		</div>
		<h1 class="inscription carved text-5xl">Non Inventum</h1>
		<p class="text-shadow mt-6 italic">
			Det här talet är inte ristat i sten.
		</p>
		<p class="mt-12">
			<a
				href="/"
				class="inscription text-shadow hover:text-inscription text-xs underline underline-offset-4"
			>
				Tillbaka
			</a>
		</p>
	</main>
</Layout>
