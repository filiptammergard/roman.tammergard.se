---
import Layout from "../layouts/Layout.astro"
import LaurelDivider from "../components/LaurelDivider.astro"
---

<Layout
	title="Not Found · Roman Numerals"
	description="The page could not be found."
>
	<main class="mx-auto max-w-2xl px-6 py-24 text-center">
		<p class="text-shadow inscription text-xs">CDIV</p>
		<LaurelDivider class="my-8" />
		<h1 class="inscription carved-deep text-5xl md:text-6xl">
			Not · Found
		</h1>
		<p class="text-shadow mt-6 font-serif italic">
			This numeral is not carved in stone.
		</p>
		<p class="mt-12">
			<a
				href="/"
				class="inscription text-shadow hover:text-imperial text-xs underline underline-offset-4"
			>
				Back
			</a>
		</p>
	</main>
</Layout>
