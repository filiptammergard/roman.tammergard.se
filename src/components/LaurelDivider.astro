---
interface Props {
	label?: string
	class?: string
}
const { label, class: cls = "" } = Astro.props
---

<div class:list={["flex items-center justify-center gap-4", cls]}>
	<!-- Left laurel branch, pointing right toward the label -->
	<svg
		viewBox="0 0 140 24"
		width="120"
		height="24"
		aria-hidden="true"
		class="shrink-0"
	>
		<g stroke="var(--c-laurel)" fill="var(--c-laurel)">
			<path d="M 5 12 L 132 12" stroke-width="1.2" fill="none"></path>
			<!-- Pairs of leaves along the branch, both sides -->
			<ellipse cx="20" cy="8" rx="9" ry="3" transform="rotate(-20 20 8)"
			></ellipse>
			<ellipse cx="20" cy="16" rx="9" ry="3" transform="rotate(20 20 16)"
			></ellipse>
			<ellipse cx="44" cy="7" rx="10" ry="3.2" transform="rotate(-22 44 7)"
			></ellipse>
			<ellipse cx="44" cy="17" rx="10" ry="3.2" transform="rotate(22 44 17)"
			></ellipse>
			<ellipse cx="70" cy="7" rx="10" ry="3.2" transform="rotate(-22 70 7)"
			></ellipse>
			<ellipse cx="70" cy="17" rx="10" ry="3.2" transform="rotate(22 70 17)"
			></ellipse>
			<ellipse cx="96" cy="7" rx="10" ry="3.2" transform="rotate(-22 96 7)"
			></ellipse>
			<ellipse cx="96" cy="17" rx="10" ry="3.2" transform="rotate(22 96 17)"
			></ellipse>
			<ellipse cx="120" cy="8" rx="9" ry="3" transform="rotate(-20 120 8)"
			></ellipse>
			<ellipse cx="120" cy="16" rx="9" ry="3" transform="rotate(20 120 16)"
			></ellipse>
		</g>
	</svg>
	{
		label && (
			<span class="inscription text-shadow shrink-0 text-xs">
				{label}
			</span>
		)
	}
	<!-- Right laurel branch (mirrored) -->
	<svg
		viewBox="0 0 140 24"
		width="120"
		height="24"
		aria-hidden="true"
		class="shrink-0"
		style="transform: scaleX(-1)"
	>
		<g stroke="var(--c-laurel)" fill="var(--c-laurel)">
			<path d="M 5 12 L 132 12" stroke-width="1.2" fill="none"></path>
			<ellipse cx="20" cy="8" rx="9" ry="3" transform="rotate(-20 20 8)"
			></ellipse>
			<ellipse cx="20" cy="16" rx="9" ry="3" transform="rotate(20 20 16)"
			></ellipse>
			<ellipse cx="44" cy="7" rx="10" ry="3.2" transform="rotate(-22 44 7)"
			></ellipse>
			<ellipse cx="44" cy="17" rx="10" ry="3.2" transform="rotate(22 44 17)"
			></ellipse>
			<ellipse cx="70" cy="7" rx="10" ry="3.2" transform="rotate(-22 70 7)"
			></ellipse>
			<ellipse cx="70" cy="17" rx="10" ry="3.2" transform="rotate(22 70 17)"
			></ellipse>
			<ellipse cx="96" cy="7" rx="10" ry="3.2" transform="rotate(-22 96 7)"
			></ellipse>
			<ellipse cx="96" cy="17" rx="10" ry="3.2" transform="rotate(22 96 17)"
			></ellipse>
			<ellipse cx="120" cy="8" rx="9" ry="3" transform="rotate(-20 120 8)"
			></ellipse>
			<ellipse cx="120" cy="16" rx="9" ry="3" transform="rotate(20 120 16)"
			></ellipse>
		</g>
	</svg>
</div>
